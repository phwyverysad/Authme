{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeBuildCommand": "npm run build:bundle",
		"beforeDevCommand": "npm run server",
		"frontendDist": "../dist",
		"devUrl": "http://localhost:3000"
	},
	"bundle": {
		"active": true,
		"category": "Utility",
		"copyright": "GPL-3.0",
		"shortDescription": "2FA authenticator",
		"externalBin": [],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.car"],
		"targets": "all",
		"publisher": "Levminer",
		"longDescription": "Simple cross-platform two-factor (2FA) authenticator app for desktop.",
		"macOS": {
			"entitlements": "./Entitlements.plist",
			"exceptionDomain": "",
			"frameworks": [],
			"providerShortName": null,
			"signingIdentity": null
		},
		"resources": ["resources/*"],
		"linux": {
			"deb": {
				"depends": []
			}
		},
		"createUpdaterArtifacts": false
	},
	"productName": "Authme",
	"version": "../package.json",
	"identifier": "com.levminer.authme",
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1MzQyQUNFQTRDNkYwMjMKUldRajhNYWt6aW8wVlJWOUFvanRGSGhoUGZMeFJFS2VkYUNvVkFBMXRBUGN3T2p1aHlsSEtQUTkK",
			"endpoints": ["https://gist.githubusercontent.com/Levminer/5a11ff3014b63bf4760ec378fe3c9441/raw"]
		}
	},
	"app": {
		"trayIcon": {
			"id": "main",
			"iconPath": "icons/32x32.png",
			"tooltip": "Authme",
			"showMenuOnLeftClick": false
		},
		"windows": [
			{
				"label": "main",
				"title": "Authme",
				"width": 1280,
				"height": 800,
				"minWidth": 550,
				"minHeight": 550,
				"center": true,
				"maximized": false,
				"visible": false,
				"theme": "Dark",
				"contentProtected": false,
				"useHttpsScheme": true,
				"devtools": true
			}
		],
		"security": {
			"csp": null
		}
	}
}
